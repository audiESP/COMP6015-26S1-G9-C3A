# The AI service reads synthetic patient context from the same development
# database as the API. Never commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=10
CHAT_DB_CONTEXT_ENABLED=true
CHAT_DB_CONTEXT_MAX_PATIENTS=6
CHAT_DB_CONTEXT_MAX_ROWS_PER_TABLE=8

# Qdrant RAG configuration. Create your own collection and credentials.
QDRANT_URL=https://YOUR-CLUSTER.REGION.cloud.qdrant.io
QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_COLLECTION=silvercare_knowledge
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHAT_RAG_ENABLED=true
RAG_TOP_K=5
CHAT_RAG_TOP_K=3
CHAT_RAG_MAX_CHARS_PER_CHUNK=600
CHAT_RAG_MIN_SCORE=0.0

# Local text generation.
C3A_AI_PORT=8001
C3A_AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=192
OLLAMA_REPORT_NUM_PREDICT=1024
OLLAMA_TRANSLATION_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_MAX_CONTEXT_CHARS=12000

# Optional local speech container.
SPEECH_SERVICE_URL=http://127.0.0.1:8002
SPEECH_SERVICE_TIMEOUT_SECONDS=120
SPEECH_MAX_UPLOAD_BYTES=10485760

# Optional Tavily fallback for task-training resources. Leave empty to disable.
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
TAVILY_TRUSTED_MIN_SCORE=0.3
TASK_MATERIALS_RELEVANCE_TIMEOUT_SECONDS=60
TASK_MATERIALS_MIN_INTERNAL_RESULTS=2
TASK_MATERIALS_MIN_SCORE=0.25
TASK_MATERIALS_WEB_MAX_RESULTS=3

DEBUG_BACKEND=false
