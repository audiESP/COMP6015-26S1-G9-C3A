FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.speech.txt ./
RUN pip install --no-cache-dir -r requirements.speech.txt
COPY speech ./speech
COPY speech_server.py ./

ENV SPEECH_ENABLED=true \
    SPEECH_BACKEND=whisper_onnx \
    SPEECH_WHISPER_ONNX_ENCODER=/models/whisper-base/base-encoder.int8.onnx \
    SPEECH_WHISPER_ONNX_DECODER=/models/whisper-base/base-decoder.int8.onnx \
    SPEECH_WHISPER_ONNX_TOKENS=/models/whisper-base/base-tokens.txt \
    SPEECH_WHISPER_ONNX_DEFAULT_LANGUAGE=en \
    SPEECH_WHISPER_ONNX_CACHE_SIZE=2 \
    SPEECH_ASR_MODEL=/models/omnilingual-asr/model.int8.onnx \
    SPEECH_ASR_TOKENS=/models/omnilingual-asr/tokens.txt \
    SPEECH_VAD_MODEL=/models/silero-vad/silero_vad.onnx \
    SPEECH_NUM_THREADS=2 \
    SPEECH_MAX_DURATION_SECONDS=20 \
    SPEECH_MAX_UPLOAD_BYTES=10485760 \
    SPEECH_TARGET_SAMPLE_RATE=16000
EXPOSE 8002
CMD ["uvicorn", "speech_server:app", "--host", "0.0.0.0", "--port", "8002"]
