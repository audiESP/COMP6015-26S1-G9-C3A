# HTTP service called by the Expo application.
C3A_API_PORT=8000
C3A_AI_BASE_URL=http://127.0.0.1:8001
C3A_AI_TIMEOUT_SECONDS=300

# Use a dedicated development PostgreSQL database. Never commit a real URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=10

# Request and upload behaviour.
DEBUG_BACKEND=false
SPEECH_MAX_UPLOAD_BYTES=10485760
